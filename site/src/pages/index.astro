---
import runtime from '../runtime.json';
import samples from '../samples.json';
import '../styles/site.css';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>isotrail: your hike as a pixel-art diorama</title>
<meta name="description" content="Turn a GPX file of your hike into a pixel-art 3D diorama, in your browser.">
<script is:inline type="module" src={`${runtime.path}isotrail-embed.js`}></script>
</head>
<body data-runtime={runtime.path}>
<header>
  <h1>isotrail</h1>
  <p>Turn a GPX file of your hike into a pixel-art 3D diorama. It is built here in your browser.</p>
</header>
<main>
  <section class="start" aria-label="Choose a hike">
    <label class="drop" id="drop">
      <input type="file" id="file" accept=".gpx,application/gpx+xml">
      <span class="drop-title">Drop a GPX file here, or choose one</span>
      <span class="drop-note">The file stays on this page. The elevation, map and weather services are asked about the area around the route and its dates.</span>
    </label>
    <div class="samples">
      <p id="samples-title">Or try a sample walk:</p>
      <ul aria-labelledby="samples-title">
        {samples.map((sample) => (
          <li>
            <button type="button" class="sample" data-sample={sample.slug} data-name={sample.name}>
              <span class="sample-name">{sample.name}</span>
              <span class="sample-where">{sample.where} · {sample.distance}</span>
            </button>
          </li>
        ))}
      </ul>
      <p class="note">The sample walks are made up. They follow mapped paths, but their times are invented.</p>
    </div>
  </section>

  <p class="kept" id="kept" hidden><span id="kept-text"></span> <button type="button" id="kept-reset">Reset them</button></p>

  <section class="build" id="build" aria-labelledby="build-title" hidden>
    <h2 id="build-title">Building <span id="build-name"></span></h2>
    <ol class="steps">
      <li data-step="elevation"><span class="step-name">Elevation tiles</span> <span class="step-count"></span></li>
      <li data-step="map-data"><span class="step-name">Map data</span> <span class="step-count"></span></li>
      <li data-step="weather"><span class="step-name">Weather</span> <span class="step-count"></span></li>
      <li data-step="building"><span class="step-name">The scene</span> <span class="step-count"></span></li>
    </ol>
    <p class="wait" id="wait" hidden></p>
    <p><button type="button" id="cancel" disabled>Cancel</button></p>
  </section>

  <div class="error" id="error" role="alert" hidden>
    <p class="error-lead" id="error-lead"></p>
    <p class="error-text" id="error-text"></p>
    <p class="actions">
      <button type="button" id="retry" hidden>Try again</button>
      <button type="button" id="no-map-data" hidden>Build without map data</button>
    </p>
  </div>

  <p class="visually-hidden" id="status" role="status"></p>

  <div class="workspace" id="workspace">
    <div class="stage">
      <section class="view" aria-label="Diorama">
        <div class="frame" id="frame">
          <p class="empty" id="empty">Your diorama shows here once you choose a hike.</p>
          <isotrail-hike id="hike" aspect="wide" autoplay hidden></isotrail-hike>
        </div>
      </section>
      <div class="after" id="after" hidden>
        <p class="shown" id="shown"></p>
        <ul class="notes" id="notes" aria-label="Notes on this scene"></ul>
        <p class="files">
          <a id="download">Download the scene file</a>
          <a id="gpx" hidden>Download the sample's GPX file</a>
        </p>
        <p class="note">Drag to turn the diorama. Hold Ctrl and scroll, or pinch, to zoom. Press play to watch the route draw itself.</p>
      </div>
    </div>

    <section class="controls" id="controls" aria-labelledby="controls-title" hidden>
      <h2 id="controls-title">Change how it looks</h2>
      <p class="note">Each change shows on the diorama at once. Open a group for more.</p>
      <div class="first" id="first"></div>
      <div class="groups" id="groups"></div>
      <div class="actions">
        <button type="button" id="reset-all">Reset to the defaults</button>
        <p class="remember" id="remember-set">
          <label class="switch"><input type="checkbox" id="remember" checked aria-describedby="remember-hint"> Remember my settings in this browser</label>
          <span class="hint" id="remember-hint">They come back on your next visit. Your GPX file and the scene are never kept.</span>
        </p>
      </div>
      <p class="palette-file" id="palette-file">
        <button type="button" id="palette-choose">Use a palette file</button>
        <input type="file" id="palette-input" accept=".hex,text/plain" hidden>
        <span class="hint">A .hex file from Lospec.</span>
      </p>
      <button type="button" id="theme-remove" hidden>Remove the theme</button>
    </section>
  </div>
</main>
<footer>
  <p><span id="cache">This browser keeps what the services answered, so a second build downloads nothing.</span> <button type="button" id="clear">Clear it</button></p>
</footer>
<script>
  import '../scripts/page.js';
</script>
</body>
</html>
